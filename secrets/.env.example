# Copy to secrets/.env (gitignored) and fill in real values to exercise
# the production/live paths. Never commit secrets/.env itself.
# See README.md "Production path" and "x402" sections for what each is for.

# Base Sepolia RPC endpoint, for src/chain/account.ts's provisionSmartAccountLive.
BASE_SEPOLIA_RPC_URL=

# Pimlico bundler/paymaster API key (https://dashboard.pimlico.io/).
PIMLICO_API_KEY=

# A funded Base Sepolia wallet's private key, for scripts/demo.ts step 3 to
# actually pay the mock x402 endpoint. Fund it with testnet USDC from
# https://faucet.circle.com/ — testnet only, no real funds involved.
DEMO_X402_PRIVATE_KEY=

# A funded Base Sepolia wallet's private key, for
# test/live-kernel-adversarial.test.ts — needs enough Base Sepolia ETH to
# cover a UserOperation's gas (or a Pimlico paymaster policy that sponsors
# it). BASE_SEPOLIA_RPC_URL and PIMLICO_API_KEY above are reused for this.
LIVE_TEST_OWNER_PRIVATE_KEY=

# Optional: override where the demo's mock seller listens, who it pays out
# to, and which x402 facilitator it uses. Defaults are fine for the demo.
# MOCK_SELLER_PORT=4021
# X402_PAY_TO=
# X402_FACILITATOR_URL=https://x402.org/facilitator
